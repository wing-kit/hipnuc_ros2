# Hipnuc IMU (CP210x USB-UART), e.g. HI13S3-USB-000
# Install: sudo cp 99-hipnuc_imu_usb.rules /etc/udev/rules.d/
#          sudo udevadm control --reload-rules && sudo udevadm trigger
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0666", GROUP:="dialout", SYMLINK+="hipnuc_imu"
